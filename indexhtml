// ================================ APP CONTROLLER ================================
const App = {
    currentPage: null,
    init: function() {
        Storage.initialize();
        if (Auth.isAuthenticated()) {
            this.navigate('dashboard');
        } else {
            this.navigate('login');
        }
    },
    navigate: function(page) {
        if (page !== 'login' && !Auth.isAuthenticated()) {
            this.navigate('login');
            return;
        }
        if (page !== 'login' && page !== 'dashboard' && !Auth.hasModuleAccess(page)) {
            DevExpress.ui.notify('You do not have access to this module', 'error', 3000);
            this.navigate('dashboard');
            return;
        }
        this.currentPage = page;
        switch (page) {
            case 'login':
                this.showLoginPage();
                break;
            case 'dashboard':
                this.showDashboardPage();
                break;
            case 'urban-forestry':
                this.showModulePage(UrbanForestryPage);
                break;
            case 'tree-plantation':
                this.showModulePage(TreePlantationPage);
                break;
            case 'waterbody-restoration':
                this.showModulePage(WaterbodyRestorationPage);
                break;
            case 'waste-management':
                this.showModulePage(WasteManagementPage);
                break;
            default:
                this.navigate('dashboard');
        }
    },
    showLoginPage: function() {
        $('#app').html(LoginPage.render());
        LoginPage.initialize();
    },
    showDashboardPage: function() {
        const content = DashboardPage.render();
        $('#app').html(Layout.render(content));
        Layout.initialize();
        DashboardPage.initialize();
    },
    showModulePage: function(modulePage) {
        const content = modulePage.render();
        $('#app').html(Layout.render(content));
        Layout.initialize();
        modulePage.initialize();
    }
};

// Initialize app when DOM is ready
$(document).ready(() => {
    App.init();
});
    </script>
