                        itemType: 'button',
                        horizontalAlignment: 'right',
                        buttonOptions: {
                            text: 'Save',
                            type: 'success',
                            onClick: () => {
                                const form = $('#urbanForestryForm').dxForm('instance');
                                if (form.validate().isValid) {
                                    onSave(form.option('formData'));
                                    this.formPopup.hide();
                                }
                            }
                        }
                    }
                ]
            });
        }, 100);
    },
    refreshGrid: function() {
        const data = Storage.getModuleData(this.MODULE_KEY);
        this.dataGrid.option('dataSource', data);
        this.dataGrid.refresh();
    }
};

