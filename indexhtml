    showForm: function(data, title, onSave) {
        this.formPopup.option('title', title);
        this.formPopup.show();
        setTimeout(() => {
            const formHtml = `
                <div id="waterbodyFormContainer">
                    <div id="waterbodyFormFields"></div>
                    ${data.id ? this.renderTimeline(data) : ''}
                </div>
            `;
            $('#waterbodyRestorationForm').html(formHtml);
            $('#waterbodyFormFields').dxForm({
                formData: data,
                labelLocation: 'top',
                items: [
                    { dataField: 'waterbodyName', label: { text: 'Waterbody Name' }, validationRules: [{ type: 'required' }] },
                    { dataField: 'type', label: { text: 'Type' }, editorType: 'dxSelectBox', editorOptions: { items: ['Lake', 'Pond', 'Canal'] } },
                    { dataField: 'location', label: { text: 'Location' }, validationRules: [{ type: 'required' }] },
                    { dataField: 'restorationPhase', label: { text: 'Restoration Phase' }, editorType: 'dxSelectBox', editorOptions: { items: ['Survey', 'Cleaning', 'Restoration', 'Completed'] } },
                    { dataField: 'startDate', label: { text: 'Start Date' }, editorType: 'dxDateBox', editorOptions: { displayFormat: 'yyyy-MM-dd', type: 'date' } },
                    { dataField: 'expectedCompletion', label: { text: 'Expected Completion' }, editorType: 'dxDateBox', editorOptions: { displayFormat: 'yyyy-MM-dd', type: 'date' } },
                    { dataField: 'partnerOrganization', label: { text: 'Partner Organization' } },
