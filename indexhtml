    renderTimeline: function(project) {
        const timeline = this.generateTimeline(project);
        return `
            <div class="timeline-container">
                <div class="timeline-header">
                    <i data-lucide="clock" style="width: 16px; height: 16px;"></i>
                    Project Timeline & Updates
                </div>
                <div class="timeline">
                    ${timeline.map(item => `
                        <div class="timeline-item">
                            <div class="timeline-dot ${item.status}"></div>
                            <div class="timeline-content">
                                <div class="timeline-date">${item.date}</div>
                                <div class="timeline-title">${item.title}</div>
                                <div class="timeline-description">${item.description}</div>
                                ${item.phase ? `<span class="timeline-phase ${item.phase.toLowerCase()}">${item.phase}</span>` : ''}
                            </div>
                        </div>
                    `).join('')}
                </div>
            </div>
        `;
    },
    generateTimeline: function(project) {
        const timeline = [];
        const startDate = new Date(project.startDate);
        const today = new Date();
        const phases = ['Survey', 'Cleaning', 'Restoration', 'Completed'];
        const currentPhaseIndex = phases.indexOf(project.restorationPhase);
        
        // Project Started
        timeline.push({
            date: startDate.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }),
            title: 'Project Initiated',
            description: `${project.waterbodyName} restoration project officially started. Partnership established with ${project.partnerOrganization}.`,
            phase: 'Survey',
            status: 'completed'
        });
        
        // Survey Phase
        if (currentPhaseIndex >= 0) {
            const surveyDate = new Date(startDate);
            surveyDate.setDate(surveyDate.getDate() + 15);
            timeline.push({
                date: surveyDate.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }),
                title: 'Initial Survey Completed',
                description: 'Comprehensive environmental assessment and water quality testing completed. Identified key restoration areas.',
                phase: 'Survey',
                status: currentPhaseIndex > 0 ? 'completed' : 'current'
            });
        }
        
        // Cleaning Phase
        if (currentPhaseIndex >= 1) {
            const cleaningDate = new Date(startDate);
            cleaningDate.setMonth(cleaningDate.getMonth() + 2);
            timeline.push({
                date: cleaningDate.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }),
                title: 'Cleaning Phase Started',
                description: 'Removal of debris, silt, and invasive species initiated. Community volunteers mobilized for cleanup drives.',
                phase: 'Cleaning',
                status: currentPhaseIndex > 1 ? 'completed' : (currentPhaseIndex === 1 ? 'current' : '')
            });
        }
        
        // Restoration Phase
        if (currentPhaseIndex >= 2) {
            const restorationDate = new Date(startDate);
            restorationDate.setMonth(restorationDate.getMonth() + 4);
            timeline.push({
                date: restorationDate.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }),
                title: 'Active Restoration in Progress',
                description: 'Structural improvements, bio-remediation measures, and native plantation underway. Regular water quality monitoring established.',
                phase: 'Restoration',
                status: currentPhaseIndex > 2 ? 'completed' : (currentPhaseIndex === 2 ? 'current' : '')
            });
        }
        
        // Completion
        if (currentPhaseIndex >= 3) {
            const completionDate = new Date(project.expectedCompletion);
            timeline.push({
                date: completionDate.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }),
                title: 'Project Successfully Completed',
                description: 'All restoration activities completed. Waterbody health indicators meet target parameters. Handover to maintenance team.',
                phase: 'Completed',
                status: 'completed'
            });
        } else {
            // Expected Completion
            const expectedDate = new Date(project.expectedCompletion);
            timeline.push({
                date: expectedDate.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }),
                title: 'Expected Completion',
                description: 'Target date for project completion and final assessment.',
                phase: '',
                status: ''
            });
        }
        
        return timeline;
    },
    refreshGrid: function() {
        const data = Storage.getModuleData(this.MODULE_KEY);
        this.dataGrid.option('dataSource', data);
        this.dataGrid.refresh();
    }
};

