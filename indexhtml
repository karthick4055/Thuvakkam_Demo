.timeline-header { font-size: 16px; font-weight: 600; color: #1a202c; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
.timeline { position: relative; padding-left: 30px; }
.timeline::before { content: ''; position: absolute; left: 8px; top: 0; bottom: 0; width: 2px; background: #cbd5e0; }
.timeline-item { position: relative; padding-bottom: 24px; }
.timeline-item:last-child { padding-bottom: 0; }
