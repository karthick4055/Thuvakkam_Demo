        });
    },
    initializeFormPopup: function() {
        this.formPopup = $('#waterbodyRestorationPopup').dxPopup({
            title: 'Project Details',
            width: 700,
            height: 'auto',
            maxHeight: '90vh',
            visible: false,
            showCloseButton: true,
            dragEnabled: true,
            showTitle: true,
            wrapperAttr: { class: 'form-popup-wrapper' },
            contentTemplate: () => $('<div>').attr('id', 'waterbodyRestorationForm').css('overflow-y', 'auto')
        }).dxPopup('instance');
    },
    addProject: function() {
        const formData = {
            waterbodyName: '',
            type: 'Lake',
            location: '',
            restorationPhase: 'Survey',
            startDate: new Date(),
            expectedCompletion: new Date(),
            partnerOrganization: '',
            status: 'Planned'
        };
        this.showForm(formData, 'Add New Project', (data) => {
            const newRecord = Storage.addRecord(this.MODULE_KEY, data);
            if (newRecord) {
                this.refreshGrid();
                DevExpress.ui.notify('Project added successfully', 'success', 2000);
            }
        });
